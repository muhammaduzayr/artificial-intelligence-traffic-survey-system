*.mp4

# YOLO checkpoints — stock ones auto-download from ultralytics on first use
# (see aitss/README.md), so there's no need to store them here.
*.pt
# aitss_v4.pt is the exception: our own fine-tuned production checkpoint,
# not downloadable from anywhere else. Tracked so it's backed up on GitHub
# instead of living only on one machine.
!aitss/aitss_v4.pt

# Survey run artifacts (reports, debug videos, diagnostics) — regenerated
# per run, not source. aitss/aitss/templates/*.xlsx is the report TEMPLATE,
# not an output, and is unaffected since it lives outside output/.
output/

# Custom-training dataset work (extracted frames, auto/hand labels, checkpoints) —
# large binary data regenerated from source footage, not source itself.
training_data/

# YOLO validation-run artifacts (plots, confusion matrices) — regenerated by
# any print_model_metrics()/val() run, not source.
runs/

venv/
.venv/

__pycache__/
*.py[cod]
*.pyo

.env

.vscode/
.idea/

.DS_Store
Thumbs.db
